[Unit]
Description=Packhound first boot: unique keys, and a disk the size of the VM's
DefaultDependencies=no
After=local-fs.target
Before=ssh.service packhound.service packhound-console.service
ConditionPathExists=!/var/lib/packhound/firstboot.done

[Service]
Type=oneshot
ExecStart=/usr/local/lib/packhound/firstboot
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
